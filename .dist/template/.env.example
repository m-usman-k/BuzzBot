# BuzzBot Environment Variables
# Rename this file to .env (or let start.bat / start.sh do it for you) and fill in the values.

# Required: your Discord bot token (Discord Developer Portal > your app > Bot > Reset Token)
BOT_TOKEN=your_bot_token_here

# Optional: enables the malicious link filter. Free key at https://www.virustotal.com
VIRUSTOTAL_API_KEY=
